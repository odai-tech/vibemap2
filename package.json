{
  "name": "vibemap",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w client",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/src/index.ts",
    "seed": "node --disable-warning=ExperimentalWarning server/src/seed.ts --reset",
    "check": "tsc -p server/tsconfig.json && tsc -p client/tsconfig.json"
  },
  "devDependencies": {
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=23.6"
  }
}
